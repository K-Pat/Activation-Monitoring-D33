# Shared settings for every machine collecting data. Every run in the dataset must use the
# same values, so change them only by agreement and before collection starts.

# Agent model, run through the hfact provider. FP8 needs a GPU with compute capability >= 8.9.
MODEL="Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8"
# Only used by Qwen3 models that have a thinking mode. Qwen3-Coder has none.
ACT_THINKING="0"

HF_REPO="d33-activation-monitoring/agent-activations"

# Control Tower and LinuxArena settings, pinned to the versions tested on the Spark (2026-11-01).
CT_REPO="https://github.com/linuxarena/control-tower"
CT_COMMIT="40982bce8e577e980a2e4949febff166c72cbf75"
SETTINGS_NAME="linuxarena"
SETTINGS_REF="b5741b052d9d7503f7312b152c5ac8ff6bff2242"
CT_DIR="${CT_DIR:-$HOME/control-tower}"

# FP8 kernels for the installed transformers version (5.20.x)
KERNELS_SPEC="kernels>=0.17.2,<0.18"

# A claim with no finished upload after this long is treated as abandoned
CLAIM_TTL_HOURS="6"

# Preflight minimums for setup_vast.sh. Weights are ~29 GB and a turn needs ~0.23 GB more per 1k
# tokens of context (measured on the Spark, 2026-11-02), so 48 GB fits episodes up to ~70k tokens.
MIN_GPU_GB="44"
MIN_DISK_GB="150"
